<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Test settings</h1>
    <p class="text-gray-600 mt-2">Make things happen now, instead of waiting for the schedule.</p>
  </div>

  <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
    <h2 class="text-lg font-semibold text-gray-900">Run pending orders now</h2>
    <p class="text-sm text-gray-600 mt-2">
      Pending orders normally run every 15 minutes. This runs them now, as one batch,
      exactly as the scheduled run would.
    </p>
    <p class="text-sm text-gray-900 mt-4">Pending orders: <strong><%= @pending_orders_count %></strong></p>
    <%= button_to "Run pending orders now", run_pending_orders_admin_test_settings_path,
                  method: :post,
                  class: "mt-4 inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6 border border-gray-200 mt-6">
    <h2 class="text-lg font-semibold text-gray-900">Set a stock's price</h2>
    <p class="text-sm text-gray-600 mt-2">
      Open a stock under <%= link_to "Stocks", admin_stocks_path, class: "text-blue-600 hover:underline" %>,
      choose Edit, and change its price and yesterday's price. Prices are in cents.
    </p>
  </div>
</div>
